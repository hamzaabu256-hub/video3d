  "lines": [
    { "who": "salem", "hook": "هل كل من يؤذيك نرجسي؟ 🚨", "text": "انتبه! أنت غالباً تستخدم هذه الكلمة بشكل خاطئ… كلمة نرجسي!", "anim": "point", "emotion": "surprised", "shot": "close" },
    { "who": "layla", "text": "صحيح. اليوم كل شخص مزعج يُسمّى نرجسياً أو توكسيك.", "anim": "talk", "emotion": "neutral", "shot": "medium", "react": { "salem": { "emotion": "surprised" } } },
    { "who": "salem", "text": "وماذا في ذلك؟ أليس هذا صحيحاً؟", "anim": "think", "emotion": "neutral", "shot": "two" },
